includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Legacy errors are recorded in phpstan-baseline.neon. New code must not add
    # to it; the baseline shrinks as modules are rewritten.
    reportUnmatchedIgnoredErrors: true
