APP_NAME=Renice
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Minutes a new order keeps its stock reserved while waiting for payment.
SHOP_PAYMENT_WINDOW_MINUTES=60
# Admins are e-mailed when a product drops to this many units.
SHOP_LOW_STOCK_THRESHOLD=5
# Timezone for dates in e-mails (stored dates are UTC).
SHOP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 + pgvector (ADR 0005). Values match the Sail services in compose.yaml.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=renice
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches all mail locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="loja@renice.test"
MAIL_FROM_NAME="${APP_NAME}"

# Pix payments: "fake" (local demo QR codes, default) or "mercadopago".
# Sandbox setup: docs/payments.md
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Semantic search (docs/search.md). Empty = keyword search only.
SEARCH_EMBEDDINGS_PROVIDER=
VOYAGEAI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Realtime (Laravel Reverb, the "reverb" service in compose.yaml). The app
# talks to it inside the Docker network; the browser on localhost:8080.
REVERB_APP_ID=renice
REVERB_APP_KEY=renice-local-key
REVERB_APP_SECRET=renice-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Container user for compose.yaml. Sail exports the real IDs on Linux/macOS;
# these defaults let plain `docker compose` work on Windows without WSL.
WWWUSER=1000
WWWGROUP=1000
